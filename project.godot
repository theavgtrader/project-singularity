; Project: Singularity
; Godot 4.7.2 Stable - standard GDScript edition
; Low-spec 2D project: Compatibility renderer, pixel-perfect viewport scaling.

config_version=5

[application]

config/name="Project: Singularity"
config/description="A retro-futurist dystopian action RPG."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=960
window/size/window_height_override=540
window/size/resizable=true
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[physics]

2d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.027451, 0.039216, 0.070588, 1)
